<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Session 17 — Structured JSON Logging.

        Outputs every log line as a single JSON object, e.g.:
        {
          "timestamp": "2026-01-15T10:23:45.123Z",
          "level": "INFO",
          "logger": "com.microservices.pro.productservice.ProductService",
          "message": "Fetching product id=1",
          "traceId": "65f2a3b4c1d2e3f4",
          "spanId":  "a1b2c3d4e5f6a7b8",
          "application": "product-service"
        }

        traceId and spanId are injected by Micrometer Tracing into the MDC
        automatically — no code change needed.

        Benefits over plain-text logs:
          - Log aggregation tools (ELK, CloudWatch) can query by traceId
          - grep: jq '.traceId == "65f2a3..."' across multiple services
          - Correlate a single request end-to-end across all microservices
    -->

    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${appName}"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

    <logger name="com.microservices.pro" level="DEBUG"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
</configuration>
